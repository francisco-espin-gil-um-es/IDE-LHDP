package ecg.rules;
dialect "java"

import ecg.ECGData;
import ecg.Ciclo;
import ecg.OndaP;
import ecg.OndaQ;
import ecg.OndaR;
import ecg.OndaS;
import ecg.OndaT;
import ecg.IntervaloPR;
import ecg.ComplejoQRS;
import ecg.IntervaloQT;
import ecg.IntervaloRR;
import ecg.FrecuenciaCardiaca;
import ecg.Diagnostico;

// Regla 1: Detectar Intervalo PR
// Cuando hay una P y una Q del mismo ciclo, crear el intervalo PR
rule "Detectar Intervalo PR"
when
    $p : OndaP( $ciclo : ciclo, $inicioP : inicio )
    $q : OndaQ( ciclo == $ciclo, $inicioQ : inicio )
    not( IntervaloPR( ciclo == $ciclo ) )
then
    insert( new IntervaloPR($inicioP, $inicioQ, $ciclo) );
    System.out.println("Intervalo PR detectado en ciclo " + $ciclo);
end

// Regla 2: Detectar Complejo QRS
// Cuando hay una Q y una S del mismo ciclo, crear el complejo QRS
rule "Detectar Complejo QRS"
when
    $q : OndaQ( $ciclo : ciclo, $inicioQ : inicio )
    $s : OndaS( ciclo == $ciclo, $finS : fin )
    not( ComplejoQRS( ciclo == $ciclo ) )
then
    insert( new ComplejoQRS($inicioQ, $finS, $ciclo) );
    System.out.println("Complejo QRS detectado en ciclo " + $ciclo);
end

// Regla 3: Detectar Intervalo QT
// Cuando hay una Q y una T del mismo ciclo, crear el intervalo QT
rule "Detectar Intervalo QT"
when
    $q : OndaQ( $ciclo : ciclo, $inicioQ : inicio )
    $t : OndaT( ciclo == $ciclo, $finT : fin )
    not( IntervaloQT( ciclo == $ciclo ) )
then
    insert( new IntervaloQT($inicioQ, $finT, $ciclo) );
    System.out.println("Intervalo QT detectado en ciclo " + $ciclo);
end

// Regla 4: Detectar Intervalo RR
// Cuando hay dos ondas R de ciclos consecutivos, crear el intervalo RR
rule "Detectar Intervalo RR"
when
    $r1 : OndaR( $ciclo1 : ciclo, $tiempoR1 : inicio )
    $r2 : OndaR( ciclo == ($ciclo1 + 1), $tiempoR2 : inicio )
    not( IntervaloRR( cicloAnterior == $ciclo1, cicloSiguiente == ($ciclo1 + 1) ) )
then
    insert( new IntervaloRR($tiempoR1, $tiempoR2, $ciclo1, $ciclo1 + 1) );
end

// Regla 5: Calcular Frecuencia Cardíaca
// Usa el primer y último intervalo RR para calcular la FC
rule "Calcular Frecuencia Cardiaca"
when
    $r1 : OndaR( $primerCiclo : ciclo, $tiempoInicio : inicio )
    not( OndaR( ciclo < $primerCiclo ) )
    $r2 : OndaR( $ultimoCiclo : ciclo, $tiempoFin : inicio )
    not( OndaR( ciclo > $ultimoCiclo ) )
    not( FrecuenciaCardiaca() )
    eval( $ultimoCiclo > $primerCiclo )
then
    double tiempoTotal = $tiempoFin - $tiempoInicio;
    int numeroCiclos = $ultimoCiclo - $primerCiclo + 1;
    double fc = (numeroCiclos / tiempoTotal) * 60000.0;
    insert( new FrecuenciaCardiaca(fc, "Total ciclos / tiempo total") );
    System.out.println("Frecuencia cardiaca: " + fc + " pul/min (" + numeroCiclos + " ciclos)");
end

// Regla 6: Actualizar ECGData con la frecuencia calculada
rule "Actualizar ECGData con Frecuencia"
when
    $fc : FrecuenciaCardiaca( $valor : valor )
    $ecg : ECGData( frecuenciaCardiaca == 0.0 )
then
    modify($ecg) { setFrecuenciaCardiaca($valor) };
end

// Regla 7: Detectar Taquicardia
rule "Taquicardia"
when
    FrecuenciaCardiaca( valor > 100 )
    not( Diagnostico( patologia == "Taquicardia" ) )
then
    insert( new Diagnostico("Taquicardia") );
    System.out.println("¡ALERTA: Taquicardia detectada!");
end

// Regla 8: Detectar Bradicardia
rule "Bradicardia"
when
    FrecuenciaCardiaca( valor > 0, valor < 60 )
    not( Diagnostico( patologia == "Bradicardia" ) )
then
    insert( new Diagnostico("Bradicardia") );
    System.out.println("¡ALERTA: Bradicardia detectada!");
end

// Regla 9: Informar Intervalos PR anormales
rule "Intervalo PR anormal"
when
    $pr : IntervaloPR( duracion < 120 || duracion > 200 )
then
    System.out.println("Intervalo PR anormal en ciclo " + $pr.getCiclo() + ": " + $pr.getDuracion() + " ms");
end

// Regla 10: Informar Complejo QRS anormal
rule "Complejo QRS anormal"
when
    $qrs : ComplejoQRS( duracion > 120 )
then
    System.out.println("Complejo QRS ensanchado en ciclo " + $qrs.getCiclo() + ": " + $qrs.getDuracion() + " ms");
end

// Regla 11: Detectar Hipocalcemia (QT prolongado >440ms)
rule "Hipocalcemia"
when
    $qt : IntervaloQT( duracion > 440 )
    not( Diagnostico( patologia == "Hipocalcemia" ) )
then
    insert( new Diagnostico("Hipocalcemia", "QT prolongado: " + $qt.getDuracion() + " ms") );
    System.out.println("¡ALERTA: Hipocalcemia detectada en ciclo " + $qt.getCiclo());
end

// Regla 12: Detectar Hipopotasemia (onda T muy negativa)
rule "Hipopotasemia"
when
    $t : OndaT( pico < -10 )
    not( Diagnostico( patologia == "Hipopotasemia" ) )
then
    insert( new Diagnostico("Hipopotasemia", "Onda T negativa: " + $t.getPico()) );
    System.out.println("¡ALERTA: Hipopotasemia detectada en ciclo " + $t.getCiclo());
end

// Regla 13: Detectar IAM - Infarto Agudo de Miocardio (onda T muy elevada >10)
rule "Infarto Agudo de Miocardio"
when
    $t : OndaT( pico > 10 )
    not( Diagnostico( patologia == "Infarto Agudo de Miocardio" ) )
then
    insert( new Diagnostico("Infarto Agudo de Miocardio", "Onda T elevada: " + $t.getPico()) );
    System.out.println("¡ALERTA: Infarto Agudo de Miocardio (IAM) detectado en ciclo " + $t.getCiclo());
end

// Regla 14: Detectar Isquemia Coronaria (onda T negativa entre -9 y -10)
rule "Isquemia Coronaria"
when
    $t : OndaT( pico < -9, pico >= -10 )
    not( Diagnostico( patologia == "Isquemia Coronaria" ) )
then
    insert( new Diagnostico("Isquemia Coronaria", "Onda T negativa: " + $t.getPico()) );
    System.out.println("¡ALERTA: Isquemia Coronaria detectada en ciclo " + $t.getCiclo());
end

// Regla 15: Detectar Contracción Ventricular Prematura (QRS muy corto <30ms)
rule "Contracción Ventricular Prematura"
when
    $qrs : ComplejoQRS( duracion < 30 )
    not( Diagnostico( patologia == "Contracción Ventricular Prematura" ) )
then
    insert( new Diagnostico("Contracción Ventricular Prematura", "QRS corto: " + $qrs.getDuracion() + " ms") );
    System.out.println("¡ALERTA: Contracción Ventricular Prematura detectada en ciclo " + $qrs.getCiclo());
end

// Regla 16: ECG Normal (si no hay patologías detectadas)
rule "ECG Normal"
when
    FrecuenciaCardiaca( valor >= 60, valor <= 100 )
    not( Diagnostico() )
then
    insert( new Diagnostico("Normal") );
    System.out.println("ECG Normal - Sin patologías detectadas");
end

